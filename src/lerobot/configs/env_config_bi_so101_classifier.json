{
  "env": {
    "name": "real_robot",
    "fps": 10,
    "robot": {
      "type": "bi_so_follower",
      "left_arm_config": {
        "port": "/dev/am_arm_follower_left",
        "id": "left_follower",
        "arm_profile": "so-arm-5dof",
        "use_degrees": true,
        "cameras": {
          "cam_left": {
            "type": "opencv",
            "index_or_path": "/dev/am_camera_wrist_left",
            "fps": 15,
            "width": 640,
            "height": 480
          },
          "cam_top": {
            "type": "opencv",
            "index_or_path": "/dev/am_camera_hand_top",
            "fps": 15,
            "width": 640,
            "height": 480
          }
        }
      },
      "right_arm_config": {
        "port": "/dev/am_arm_follower_right",
        "id": "right_follower",
        "arm_profile": "so-arm-5dof",
        "use_degrees": true,
        "cameras": {
          "cam_right": {
            "type": "opencv",
            "index_or_path": "/dev/am_camera_wrist_right",
            "fps": 15,
            "width": 640,
            "height": 480
          }
        }
      }
    },
    "teleop": {
      "type": "bi_so_leader",
      "left_arm_config": {
        "port": "/dev/am_arm_leader_left",
        "use_degrees": true,
        "arm_profile": "so-arm-5dof",
        "invert_gripper": true
      },
      "right_arm_config": {
        "port": "/dev/am_arm_leader_right",
        "use_degrees": true,
        "arm_profile": "so-arm-5dof"
      }
    },
    "processor": {
      "control_mode": "leader",
      "observation": {
        "add_joint_velocity_to_observation": false,
        "add_current_to_observation": false,
        "display_cameras": false
      },
      "image_preprocessing": {
        "crop_params_dict": {},
        "resize_size": [
          128,
          128
        ]
      },
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": 0.0
      },
      "reset": {
        "reset_time_s": 5.0,
        "control_time_s": 20.0,
        "terminate_on_success": false
      }
    }
  },
  "dataset": {
    "repo_id": null,
    "root": "data/bi_so101_classifier_data",
    "task": "pick_and_place",
    "num_episodes_to_record": 20,
    "replay_episode": null,
    "push_to_hub": false
  },
  "mode": "record",
  "device": "cuda"
}