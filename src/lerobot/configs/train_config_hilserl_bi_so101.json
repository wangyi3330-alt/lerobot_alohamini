{
  "policy": {
    "type": "sac",
    "device": "cuda",
    "storage_device": "cuda",
    "input_features": {
      "observation.state": {
        "type": "STATE",
        "shape": [
          12
        ]
      },
      "observation.images.cam_left": {
        "type": "VISUAL",
        "shape": [
          3,
          128,
          128
        ]
      },
      "observation.images.cam_right": {
        "type": "VISUAL",
        "shape": [
          3,
          128,
          128
        ]
      },
      "observation.images.cam_top": {
        "type": "VISUAL",
        "shape": [
          3,
          128,
          128
        ]
      }
    },
    "output_features": {
      "action": {
        "type": "ACTION",
        "shape": [
          12
        ]
      }
    },
    "online_step_before_learning": 200,
    "utd_ratio": 2,
    "batch_size": 256,
    "temperature_init": 0.01,
    "actor_learner_config": {
      "learner_host": "127.0.0.1",
      "learner_port": 50051,
      "policy_parameters_push_frequency": 2
    }
  },
  "dataset": {
    "repo_id": null,
    "root": "data/bi_so101_offline_data_cropped_resized"
  },
  "env": {
    "name": "real_robot",
    "fps": 10,
    "robot": {
      "type": "bi_so_follower",
      "left_arm_config": {
        "port": "/dev/am_arm_follower_left",
        "id": "left_follower",
        "arm_profile": "so-arm-5dof",
        "use_degrees": true,
        "cameras": {
          "cam_left": {
            "type": "opencv",
            "index_or_path": "/dev/am_camera_wrist_left",
            "fps": 15,
            "width": 640,
            "height": 480
          },
          "cam_top": {
            "type": "opencv",
            "index_or_path": "/dev/am_camera_head_top",
            "fps": 15,
            "width": 640,
            "height": 480
          }
        }
      },
      "right_arm_config": {
        "port": "/dev/am_arm_follower_right",
        "id": "right_follower",
        "arm_profile": "so-arm-5dof",
        "use_degrees": true,
        "cameras": {
          "cam_right": {
            "type": "opencv",
            "index_or_path": "/dev/am_camera_wrist_right",
            "fps": 15,
            "width": 640,
            "height": 480
          }
        }
      }
    },
    "teleop": {
      "type": "bi_so_leader",
      "left_arm_config": {
        "port": "/dev/am_arm_leader_left",
        "use_degrees": true,
        "arm_profile": "so-arm-5dof"
      },
      "right_arm_config": {
        "port": "/dev/am_arm_leader_right",
        "use_degrees": true,
        "arm_profile": "so-arm-5dof"
      }
    },
    "processor": {
      "control_mode": "leader",
      "observation": {
        "add_joint_velocity_to_observation": false,
        "add_current_to_observation": false,
        "display_cameras": false
      },
      "image_preprocessing": {
        "crop_params_dict": {
          "observation.images.cam_left": [
            0,
            0,
            480,
            640
          ],
          "observation.images.cam_right": [
            0,
            0,
            480,
            640
          ],
          "observation.images.cam_top": [
            0,
            0,
            480,
            640
          ]
        },
        "resize_size": [
          128,
          128
        ]
      },
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": 0.0
      },
      "reset": {
        "reset_time_s": 5.0,
        "control_time_s": 20.0,
        "terminate_on_success": true
      },
      "reward_classifier": {
        "pretrained_path": "outputs/bi_so101_reward_classifier/checkpoints/last/pretrained_model",
        "success_threshold": 0.7,
        "success_reward": 1.0
      }
    }
  },
  "output_dir": "outputs/bi_so101_hilserl",
  "seed": 42,
  "wandb": {
    "enable": false,
    "project": "bi_so101_hilserl"
  }
}