{
  "env": {
    "name": "real_robot",
    "fps": 15,
    "robot": {
      "type": "so101_follower",
      "port": "/dev/am_arm_follower_left",
      "id": "follower",
      "arm_profile": "so-arm-5dof",
      "use_degrees": true,
      "cameras": {
        "cam_left": {
          "type": "opencv",
          "index_or_path": 2,
          "fps": 15,
          "width": 640,
          "height": 480,
          "fourcc": "MJPG"
        },
        "cam_top": {
          "type": "intelrealsense",
          "serial_number_or_name": "335522070619",
          "fps": 15,
          "width": 640,
          "height": 480
        }
      }
    },
    "teleop": {
      "type": "so101_leader",
      "port": "/dev/am_arm_leader_left",
      "use_degrees": true,
      "arm_profile": "so-arm-5dof",
      "invert_gripper": true
    },
    "processor": {
      "control_mode": "leader",
      "observation": {
        "add_joint_velocity_to_observation": false,
        "add_current_to_observation": false,
        "display_cameras": false
      },
      "image_preprocessing": {
        "crop_params_dict": {},
        "resize_size": [
          128,
          128
        ]
      },
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": 0.0
      },
      "reset": {
        "reset_time_s": 5.0,
        "control_time_s": 20.0,
        "terminate_on_success": false
      }
    }
  },
  "dataset": {
    "repo_id": null,
    "root": "data/so101_offline_data",
    "task": "pick_and_place",
    "num_episodes_to_record": 20,
    "replay_episode": null,
    "push_to_hub": false
  },
  "mode": "record",
  "device": "cuda"
}